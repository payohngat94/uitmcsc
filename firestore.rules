
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---

    // Checks if the user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if the user's UID is in the hardcoded list of admins.
    // IMPORTANT: You MUST replace the placeholder UIDs with the actual UIDs of your admin users.
    function isAdmin() {
      return request.auth.uid in [
        'REPLACE_WITH_YOUR_ADMIN_UID_1'
        // You can add more admin UIDs here, like:
        // 'REPLACE_WITH_YOUR_ADMIN_UID_2', 
      ];
    }
    
    // --- Collection Rules ---

    // This rule applies to ALL collections in your database.
    match /{document=**} {
      // Any signed-in user can read any document.
      allow read: if isSignedIn();
      
      // Only admins can write (create, update, delete) any document.
      allow write: if isAdmin();
    }
  }
}
