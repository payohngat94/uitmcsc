
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    // Checks if the user's UID is in the hardcoded list of admin UIDs.
    // IMPORTANT: You MUST replace the placeholder with your actual admin User ID.
    function isAdmin() {
      return request.auth.uid in ['REPLACE_WITH_YOUR_ADMIN_UID_1'];
    }

    // Checks if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Collection Rules ---
    // For any collection in the database...
    match /{collection}/{docId} {
      // Any signed-in user (admin, student, or guest) can read data.
      allow read: if isSignedIn();
      
      // Only users whose UID is in the admin list can write (create, update, delete) data.
      allow write: if isAdmin();
    }
  }
}
