rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // =====================================================================
    // Helper Functions
    // =====================================================================

    // Function to check if a user is authenticated.
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Function to check if the requesting user is the owner of a document.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Function to get a user's role from their profile document.
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Function to check if the user is an admin.
    // IMPORTANT: This checks against a hardcoded list of UIDs to avoid circular
    // dependencies when checking other rules.
    // TO ADD AN ADMIN: Find their UID in the Firebase Console (Authentication tab)
    // and add it to the list below.
    function isAdmin() {
      let adminUIDs = [
        'REPLACE_WITH_YOUR_ADMIN_UID_1',
        'REPLACE_WITH_YOUR_ADMIN_UID_2'
        // Add more admin UIDs here
      ];
      return isSignedIn() && request.auth.uid in adminUIDs;
    }

    // Function to check if a user's role is 'student'.
    function isStudent() {
      return isSignedIn() && getRole(request.auth.uid) == 'student';
    }

    // Function to check if a user is an anonymous guest.
    function isGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // =====================================================================
    // Collection Rules
    // =====================================================================

    // users: 
    // - Admins can read/write any profile.
    // - Any signed-in user can read their own profile.
    // - Any user can create their own profile document during sign-up.
    match /users/{userId} {
      allow read: if (isSignedIn() && isOwner(userId)) || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // learningMaterialCategories: Admins can manage, any signed-in user can read.
    match /learningMaterialCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // create, update, delete
    }
    
    // learningMaterials: Admins can manage, any signed-in user can read.
    match /learningMaterials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // create, update, delete
    }
    
    // announcements: Admins can manage, any signed-in user can read.
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // create, update, delete
    }
    
    // inventoryItems: Admins can manage, any signed-in user (including guests) can read.
    match /inventoryItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // create, update, delete
    }
    
    // Default deny all other access to prevent accidental exposure.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
